package components

import (
	"fmt"
	"time"

	"merge/internal/model"
)

templ PullRequestDiscussion(pullRequest model.StampedPullRequest, comments []model.PullRequestComment) {
	<div class="context-pane-discussion" id={ fmt.Sprintf("discussion-%d", pullRequest.Number) } data-loaded="true">
		<h2>Discussion</h2>
		if len(comments) == 0 {
			<p>No comments yet.</p>
		} else {
			for _, comment := range comments {
				<article class="discussion-comment">
					<div class="discussion-comment-header">
						<a class="meta-link" href={ templ.SafeURL(comment.User.HTMLURL) }>{ comment.User.Login }</a>
						if createdAt, err := time.Parse(time.RFC3339, comment.CreatedAt); err == nil {
							<time datetime={ comment.CreatedAt }>{ createdAt.Format("Jan 2, 2006 3:04 PM") }</time>
						}
					</div>
					<div class="content">@Markdown(comment.Body)</div>
				</article>
			}
		}
	</div>
}
