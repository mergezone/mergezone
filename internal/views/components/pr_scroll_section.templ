package components

import "merge/internal/model"

templ PullRequestScrollItems(pullRequests []model.StampedPullRequest, filters model.RepositoryFilters) {
	for _, pullRequest := range pullRequests {
		@PullRequestCard(pullRequest, filters)
	}
}

templ PullRequestLoadMoreControl(filters model.RepositoryFilters, nextPullRequestPage int, hasMorePullRequests bool, replaceOutOfBandContent bool) {
	<div
		id="load-more-card"
		class="mt-2 compact:mt-1"
		if replaceOutOfBandContent {
			hx-swap-oob="true"
		}
	>
		<div
			class="item load-more flex min-h-16 cursor-pointer items-center justify-center gap-2 rounded-lg border border-dashed border-base-300 bg-base-100 text-base-content/60 transition-colors hover:bg-base-200 compact:min-h-12"
			hx-get={ filters.PageURL(nextPullRequestPage) }
			hx-target="#scroll-content"
			hx-swap="beforeend"
		>
			<i class="fa-solid fa-plus text-sm"></i>
			<span class="text-sm">Load more</span>
			<span class="loading loading-spinner loading-xs htmx-indicator"></span>
		</div>
	</div>
}

templ PullRequestScrollSection(pullRequests []model.StampedPullRequest, filters model.RepositoryFilters, currentPage int, hasMorePullRequests bool) {
	<h2 class="mt-2 px-1 text-sm font-bold text-base-content/70">
		<span class="whitespace-nowrap">Pull Requests</span>
	</h2>
	<div class="pull-request-list" id="scroll-content">
		@PullRequestScrollItems(pullRequests, filters)
	</div>
	@PullRequestLoadMoreControl(filters, currentPage+1, hasMorePullRequests, false)
}
