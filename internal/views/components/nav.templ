package components

templ RepositoryNavigation(owner, repository string) {
	<nav id="nav" x-data="nav" class="flex flex-col gap-4 border-b border-base-300 p-4">
		<div class="flex items-center justify-between gap-4">
			<div class="text-xl font-bold tracking-tight">
				<a class="text-base-content no-underline hover:underline hover:decoration-base-content/40 hover:decoration-2 hover:underline-offset-4" href="/">Merge Zone</a>
			</div>
			<button id="theme-toggle" class="btn btn-ghost btn-sm btn-square text-base-content/60 hover:text-base-content" @click="$store.app.cycleTheme()" aria-label="Toggle light and dark theme">
				<i
					class="fa-solid"
					:class="{
                    'fa-sun': $store.app.theme === 'light',
                    'fa-moon': $store.app.theme === 'dark'
                }"
					aria-hidden="true"
				></i>
			</button>
		</div>
		<div id="nav-search-slot">
			@RepositorySearchInput(owner, repository, "…", "…", true, true)
		</div>
	</nav>
}
