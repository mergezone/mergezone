package components

import "merge/internal/model"

// MobileDock is the bottom action bar shown on small screens. Alpine relocates
// the repository search input into #mobile-dock-search (see
// syncSearchPlacement in alpine.js). On repository pages it also renders the
// button that toggles the filter bottom sheet. Because the dock is fixed to the
// viewport bottom and the page shell reserves its height, the filter sheet and the
// context pane open above the dock rather than covering it.
templ MobileDock(showFilters bool, filters model.RepositoryFilters) {
	<div class="mobile-dock fixed inset-x-0 bottom-0 z-40 flex h-[calc(4rem+env(safe-area-inset-bottom))] items-center gap-2 border-t border-base-300 bg-base-200 px-4 pt-2 pb-[calc(0.5rem+env(safe-area-inset-bottom))] lg:hidden" id="mobile-dock">
		<div class="mobile-dock-search flex min-w-0 flex-1 items-center overflow-x-auto whitespace-nowrap" id="mobile-dock-search"></div>
		if showFilters {
			<button
				class="btn btn-ghost btn-sm mobile-dock-filter h-auto min-h-0 flex-none gap-2 border border-base-300 px-3 font-semibold text-base-content hover:bg-base-300"
				type="button"
				aria-label="Filters"
				title="Filters"
				@click.stop="$store.filterPanel.toggle()"
			>
				<i class="fa-solid" :class="$store.filterPanel.open ? 'fa-xmark' : 'fa-sliders'" aria-hidden="true"></i>
				<span>Filters</span>
			</button>
		}
	</div>
}
