package components

import (
	"fmt"

	"merge/internal/model"
	"merge/internal/views/helpers"
)

templ PullRequestCard(pullRequest model.StampedPullRequest, filters model.RepositoryFilters) {
	{{
		paneSeed := map[string]any{
			"number":          pullRequest.Number,
			"owner":           filters.Owner,
			"repository":      filters.Repository,
			"title":           pullRequest.Title,
			"titleHtml":       helpers.RenderMarkdownInline(pullRequest.Title),
			"state":           pullRequest.State,
			"statusClass":     helpers.GetStatusClass(pullRequest),
			"expiryStatus":    helpers.ExpiryLabel(pullRequest),
			"expiryIconClass": helpers.StatusIconClass(pullRequest),
			"supersededBy": func() any {
				if pullRequest.SupersededBy == nil {
					return nil
				}
				return map[string]any{
					"number": pullRequest.SupersededBy.Number,
					"url":    pullRequest.SupersededBy.URL,
					"reason": helpers.SupersessionReason(pullRequest),
				}
			}(),
			"expiryReason": helpers.ExpiryReason(pullRequest),
			"url":          pullRequest.URL,
			"comments":     pullRequest.CommentCount(),
			"age":          model.TimeAgoLong(pullRequest.TimeOpen, pullRequest.DaysOpen),
			"authorName":   pullRequest.Author.Name,
			"authorURL":    pullRequest.Author.URL,
			"scope": func() string {
				if len(pullRequest.Scopes) > 0 {
					return pullRequest.Scopes[0]
				}
				return ""
			}(),
			"scopeURL": func() string {
				if len(pullRequest.Scopes) > 0 {
					return filters.WithScope(pullRequest.Scopes[0]).URL()
				}
				return ""
			}(),
			"bodyHtml": helpers.RenderMarkdown(pullRequest.Body),
			"refs":     helpers.PullRequestReferences(pullRequest.Body),
		}
	}}
	<div
		class="item pull-request group min-h-16 cursor-pointer rounded-lg border border-base-300 bg-base-100 p-3 transition-colors hover:bg-base-200 data-[selected=true]:bg-base-200"
		data-draft={ fmt.Sprintf("%t", pullRequest.IsDraft) }
		data-pull-request-number={ fmt.Sprintf("%d", pullRequest.Number) }
		data-pull-request-title={ pullRequest.Title }
		data-pull-request-state={ pullRequest.State }
		data-pull-request-status-class={ helpers.GetStatusClass(pullRequest) }
		data-pull-request-expiry-status={ helpers.ExpiryLabel(pullRequest) }
		data-pull-request-expiry-icon-class={ helpers.StatusIconClass(pullRequest) }
		data-pull-request-expiry-reason={ helpers.ExpiryReason(pullRequest) }
		data-selected="false"
		if pullRequest.SupersededBy != nil {
			data-pull-request-superseded-by-number={ fmt.Sprintf("%d", pullRequest.SupersededBy.Number) }
			data-pull-request-superseded-by-url={ pullRequest.SupersededBy.URL }
			data-pull-request-superseded-by-reason={ helpers.SupersessionReason(pullRequest) }
		}
		data-pull-request-url={ pullRequest.URL }
		data-pull-request-comments={ fmt.Sprintf("%d", pullRequest.CommentCount()) }
		data-pull-request-age={ model.TimeAgoLong(pullRequest.TimeOpen, pullRequest.DaysOpen) }
		data-pull-request-author-name={ pullRequest.Author.Name }
		data-pull-request-author-url={ pullRequest.Author.URL }
		if len(pullRequest.Scopes) > 0 {
			data-pull-request-scope={ pullRequest.Scopes[0] }
			data-pull-request-scope-url={ filters.WithScope(pullRequest.Scopes[0]).URL() }
		}
		hx-on:click="Alpine.store('contextPane').openPane(Number(this.dataset.pullRequestNumber), this.dataset)"
	>
		<div hidden class="pull-request-seed">
			@templ.JSONScript("", paneSeed)
		</div>
		<div class="pull-request-header grid grid-cols-[auto_1fr] grid-rows-[auto_auto] gap-x-3 gap-y-1">
			<div class="flex items-center justify-center">
				<i class={ fmt.Sprintf("status-icon fa-solid text-lg %s", helpers.GetStatusClass(pullRequest)) }></i>
			</div>
			<div class="flex items-start text-base-content">
				<b class="item-title block text-base leading-snug font-semibold [&_p]:m-0">
					@Markdown(pullRequest.Title)
				</b>
			</div>
			<div class="col-start-2 flex min-w-0 text-xs text-base-content/60">
				<ul class="flex flex-wrap items-center gap-y-1 [&>li+li]:before:px-2 [&>li+li]:before:content-['·']">
					<li>
						#{ pullRequest.Number }
					</li>
					<li class="capitalize">
						{ pullRequest.State }
					</li>
					<li title="Discussion">
						<i class="fa-regular fa-comments mr-1" aria-hidden="true"></i> { fmt.Sprintf("%d", pullRequest.CommentCount()) }
					</li>
					<li title={ model.TimeAgoLong(pullRequest.TimeOpen, pullRequest.DaysOpen) }>
						@Age(pullRequest.TimeOpen, pullRequest.DaysOpen)
					</li>
					<li>
						<a class="inline-flex items-center gap-1 hover:underline hover:decoration-2" href={ pullRequest.Author.URL }>
							if pullRequest.Author.AvatarURL != "" {
								<img class="size-4 rounded-md object-cover" src={ templ.SafeURL(pullRequest.Author.AvatarURL) } alt={ pullRequest.Author.Name + "'s profile picture" } loading="lazy"/>
							}
							{ pullRequest.Author.Name }
						</a>
					</li>
					for _, scope := range pullRequest.Scopes {
						{{ scopeURL := filters.WithScope(scope).URL() }}
						<li>
							<a class="hover:underline hover:decoration-2" href={ templ.SafeURL(scopeURL) } hx-get={ templ.SafeURL(scopeURL) } hx-target="#page-shell" hx-push-url="true">{ scope }</a>
						</li>
					}
				</ul>
			</div>
		</div>
	</div>
}
