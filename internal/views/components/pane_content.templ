package components

import "merge/internal/model"

// PullRequestDetail renders the description content for a single pull request.
templ PullRequestDetail(pullRequest model.StampedPullRequest) {
	<div class="content context-pane-description-content prose prose-sm max-w-none dark:prose-invert [&_iframe]:my-4 [&_iframe]:aspect-video [&_iframe]:w-full [&_iframe]:rounded-md [&_iframe]:border-0 [&_img]:rounded-md [&_video]:my-4 [&_video]:w-full [&_video]:rounded-md">
		@Markdown(pullRequest.Body)
	</div>
}
