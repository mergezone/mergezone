package components

import (
	"fmt"
	"strings"

	"merge/internal/model"
	"merge/internal/views/helpers"
)

// PullRequestDetail renders the detail fragment for a single pull request.
templ PullRequestDetail(pullRequest model.StampedPullRequest, owner, repository, currentPath string) {
	<div class="context-pane-header">
		<a class="context-pane-title" href={ pullRequest.URL }>
			<i class={ "status-icon fa-solid " + helpers.GetStatusClass(pullRequest) }></i>
			if pullRequest.Title != "" {
				@Markdown(pullRequest.Title)
			} else {
				Pull Request
			}
			<i class="fa-solid fa-up-right-from-square"></i>
		</a>
		<button class="icon-close-button" aria-label="Close" onclick="Alpine.store('contextPane').closePane()">
			<i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
		</button>
	</div>
	<div class="context-pane-body scroll">
		<table class="table is-fullwidth context-pane-meta">
			<tbody>
				<tr class="meta-row">
					<th class="meta-label" scope="row"><i class="fa-solid fa-hashtag" aria-hidden="true"></i> Number</th>
					<td class="meta-value">{ fmt.Sprintf("#%d", pullRequest.Number) }</td>
				</tr>
				<tr class="meta-row">
					<th class="meta-label" scope="row"><i class="fa-solid fa-code-pull-request" aria-hidden="true"></i> Status</th>
					<td class="meta-value">{ pullRequest.State }</td>
				</tr>
				<tr class="meta-row">
					<th class="meta-label" scope="row"><i class="fa-solid fa-clock" aria-hidden="true"></i> Age</th>
					<td class="meta-value">@Age(pullRequest.TimeOpen, pullRequest.DaysOpen)</td>
				</tr>
				<tr class="meta-row">
					<th class="meta-label" scope="row"><i class="fa-regular fa-comments" aria-hidden="true"></i> Discussion</th>
					<td class="meta-value">{ fmt.Sprintf("%d", pullRequest.CommentCount()) }</td>
				</tr>
				<tr class="meta-row">
					<th class="meta-label" scope="row"><i class="fa-solid fa-user" aria-hidden="true"></i> Author</th>
					{{ authorPath := helpers.StripQueryParam(currentPath, "contributor")
					currentStatus := helpers.GetQueryParam(currentPath, "status")
					q := []string{"contributor=" + pullRequest.Author.Name}
					if currentStatus != "" {
						q = append(q, "status="+currentStatus)
					}
					authorURL := authorPath + "?" + strings.Join(q, "&")
					}}
					<td class="meta-value">
						<a class="meta-link" href={ templ.SafeURL(authorURL) } hx-get={ templ.SafeURL(authorURL) } hx-target="section.scroll">{ pullRequest.Author.Name }</a>
					</td>
				</tr>
				if len(pullRequest.Scopes) > 0 {
					<tr class="meta-row">
						<th class="meta-label" scope="row"><i class="fa-solid fa-tag" aria-hidden="true"></i> Scope</th>
						{{ scopeURL := fmt.Sprintf("/%s/%s/%s", owner, repository, pullRequest.Scopes[0])
						currentStatus := helpers.GetQueryParam(currentPath, "status")
						currentContributor := helpers.GetQueryParam(currentPath, "contributor")
						q := []string{}
						if currentContributor != "" {
							q = append(q, "contributor="+currentContributor)
						}
						if currentStatus != "" {
							q = append(q, "status="+currentStatus)
						}
						if len(q) > 0 {
							scopeURL += "?" + strings.Join(q, "&")
						}
						}}
						<td class="meta-value">
							<a class="meta-link" href={ templ.SafeURL(scopeURL) } hx-get={ templ.SafeURL(scopeURL) } hx-target="section.scroll">{ pullRequest.Scopes[0] }</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
		<div class="content">
			@Markdown(pullRequest.Body)
		</div>
		<div class="context-pane-discussion" id={ fmt.Sprintf("discussion-%d", pullRequest.Number) } hx-get={ fmt.Sprintf("/%s/%s?fragment=pr-discussion&number=%d", owner, repository, pullRequest.Number) } hx-trigger="load" hx-swap="outerHTML">
			<h2>Discussion</h2>
			<div class="discussion-comments">
				<div class="discussion-comment discussion-comment-skeleton" aria-hidden="true">
					<div class="discussion-comment-header">
						<span class="skeleton discussion-skeleton-author"></span>
						<span class="skeleton discussion-skeleton-date"></span>
					</div>
					<div class="discussion-skeleton-body">
						<span class="skeleton discussion-skeleton-line"></span>
						<span class="skeleton discussion-skeleton-line"></span>
						<span class="skeleton discussion-skeleton-line short"></span>
					</div>
				</div>
				<div class="discussion-comment discussion-comment-skeleton" aria-hidden="true">
					<div class="discussion-comment-header">
						<span class="skeleton discussion-skeleton-author"></span>
						<span class="skeleton discussion-skeleton-date"></span>
					</div>
					<div class="discussion-skeleton-body">
						<span class="skeleton discussion-skeleton-line"></span>
						<span class="skeleton discussion-skeleton-line"></span>
						<span class="skeleton discussion-skeleton-line short"></span>
					</div>
				</div>
			</div>
		</div>
	</div>
}
