package components

import (
	"slices"
	"unicode"

	"merge/internal/model"
)

func repositoryStatusURL(filters model.RepositoryFilters, targetStatus string) string {
	if slices.Contains(filters.Status, targetStatus) {
		return filters.WithStatus("").URL()
	}
	return filters.WithStatus(targetStatus).URL()
}

func titleCaseFirst(value string) string {
	runes := []rune(value)
	if len(runes) == 0 {
		return value
	}
	runes[0] = unicode.ToTitle(runes[0])
	return string(runes)
}

// PullRequestCounts renders the repository's status summaries and filter controls.
templ PullRequestCounts(expiryCounts model.ExpiryCounts, hasMorePullRequests bool, filters model.RepositoryFilters, nextPullRequestPage int) {
	<div class="stats">
		<div class="section-heading">
			<span>Overview</span>
		</div>
		<div class="level is-mobile stats-tiles">
			<div class="level-item">
				@PullRequestStatusCount("fa-seedling ok", expiryCounts.FreshCount, "Fresh", repositoryStatusURL(filters, "fresh"), slices.Contains(filters.Status, "fresh"))
			</div>
			<div class="level-item">
				@PullRequestStatusCount("fa-leaf warn", expiryCounts.StaleCount, "Stale", repositoryStatusURL(filters, "stale"), slices.Contains(filters.Status, "stale"))
			</div>
			<div class="level-item">
				@PullRequestStatusCount("fa-skull error", expiryCounts.ExpiredCount, "Expired", repositoryStatusURL(filters, "expired"), slices.Contains(filters.Status, "expired"))
			</div>
			<div class="level-item">
				@PullRequestStatusCount("fa-code-merge special", expiryCounts.MergedCount, "Merged", repositoryStatusURL(filters, "merged"), slices.Contains(filters.Status, "merged"))
			</div>
		</div>
	</div>
}
