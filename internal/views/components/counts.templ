package components

import (
	"slices"
	"unicode"

	"merge/internal/model"
)

// repositoryStatusURL toggles targetStatus in the current selection: clicking
// a selected status removes only that status, clicking an unselected one adds it.
func repositoryStatusURL(filters model.RepositoryFilters, targetStatus string) string {
	return filters.WithStatus(targetStatus).URL()
}

func titleCaseFirst(value string) string {
	runes := []rune(value)
	if len(runes) == 0 {
		return value
	}
	runes[0] = unicode.ToTitle(runes[0])
	return string(runes)
}

// PullRequestCounts renders the repository's status summaries and filter controls.
templ PullRequestCounts(expiryCounts model.ExpiryCounts, hasMorePullRequests bool, filters model.RepositoryFilters, nextPullRequestPage int) {
	<div class="stats flex flex-col gap-2">
		<div class="my-2 flex items-center justify-between gap-2 px-1 text-sm font-semibold text-base-content/70">
			<span>Overview</span>
		</div>
		<div class="grid grid-cols-2 gap-2 lg:grid-cols-4">
			@PullRequestStatusCount("fa-seedling text-success", expiryCounts.FreshCount, "Fresh", repositoryStatusURL(filters, "fresh"), slices.Contains(filters.Status, "fresh"))
			@PullRequestStatusCount("fa-leaf text-warning", expiryCounts.StaleCount, "Stale", repositoryStatusURL(filters, "stale"), slices.Contains(filters.Status, "stale"))
			@PullRequestStatusCount("fa-skull text-error", expiryCounts.ExpiredCount, "Expired", repositoryStatusURL(filters, "expired"), slices.Contains(filters.Status, "expired"))
			@PullRequestStatusCount("fa-code-merge text-accent", expiryCounts.MergedCount, "Merged", repositoryStatusURL(filters, "merged"), slices.Contains(filters.Status, "merged"))
		</div>
	</div>
}
