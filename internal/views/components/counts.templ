package components

import (
	"strings"

	"merge/internal/model"
)

func repositoryStatusURL(filters model.RepositoryFilters, targetStatus string) string {
	if filters.Status == targetStatus {
		return filters.WithStatus("").URL()
	}
	return filters.WithStatus(targetStatus).URL()
}

func repositoryFilterLabel(filters model.RepositoryFilters) string {
	parts := []string{}
	if filters.Scope != "" {
		parts = append(parts, strings.ToUpper(filters.Scope))
	}
	if filters.Status != "" {
		parts = append(parts, strings.ToUpper(filters.Status))
	}
	if filters.Contributor != "" {
		parts = append(parts, strings.ToUpper(filters.Contributor))
	}
	return "Filter: " + strings.Join(parts, ", ")
}

// PullRequestCounts renders the repository's status summaries and filter controls.
templ PullRequestCounts(expiryCounts model.ExpiryCounts, hasMorePullRequests bool, filters model.RepositoryFilters, nextPullRequestPage int) {
	<div class="stats">
		<div class="section-heading">
            <span>Overview</span>
			<div class="buttons">
				if filters.Scope != "" || filters.Contributor != "" || filters.Status != "" {
					<button class="filter-toggle" id="filter-toggle" type="button" aria-label="Toggle filter" hx-on:click="Alpine.store('filterPanel').openPanel()">{ repositoryFilterLabel(filters) }</button>
					<a class="link-button" id="filter-clear"
						href={ templ.SafeURL(filters.URL()) }
						hx-get={ templ.SafeURL(filters.URL()) }
						hx-target="main"
						hx-push-url="true">Clear</a>
				} else {
					<button class="filter-toggle" id="filter-toggle" type="button" aria-label="Toggle filter" hx-on:click="Alpine.store('filterPanel').openPanel()">Filter</button>
				}
			</div>
        </div>
		<div class="stats-tiles">
			@PullRequestStatusCount("fa-seedling ok", expiryCounts.FreshCount, "fresh", repositoryStatusURL(filters, "fresh"), filters.Status == "fresh")
			@PullRequestStatusCount("fa-leaf warn", expiryCounts.StaleCount, "stale", repositoryStatusURL(filters, "stale"), filters.Status == "stale")
			@PullRequestStatusCount("fa-skull error", expiryCounts.ExpiredCount, "expired", repositoryStatusURL(filters, "expired"), filters.Status == "expired")
			@PullRequestStatusCount("fa-code-merge special", expiryCounts.MergedCount, "merged", repositoryStatusURL(filters, "merged"), filters.Status == "merged")
		</div>
	</div>
}
