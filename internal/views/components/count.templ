package components

import "fmt"

templ PullRequestStatusCount(iconClass string, pullRequestCount int, statusLabel string, destinationURL string, isActive bool) {
	if destinationURL != "" {
		<div
			class="status-tile"
			data-active={ fmt.Sprintf("%t", isActive) }
			hx-get={ templ.SafeURL(destinationURL) }
			hx-target="#page-shell"
			hx-push-url="true"
		>
			<p class="status-tile-label">{ statusLabel }</p>
			<i class={ "status-tile-icon status-icon fa-solid " + iconClass }></i>
			<b class="status-tile-count">{ fmt.Sprintf("%d", pullRequestCount) }</b>
		</div>
	} else {
		<div class="status-tile" data-active={ fmt.Sprintf("%t", isActive) }>
			<p class="status-tile-label">{ statusLabel }</p>
			<i class={ "status-tile-icon status-icon fa-solid " + iconClass }></i>
			<b class="status-tile-count">{ fmt.Sprintf("%d", pullRequestCount) }</b>
		</div>
	}
}

templ InlinePullRequestCount(iconClass string, pullRequestCount int) {
	<div class="inline-flex items-center gap-1">
		<i class={ "status-icon fa-solid " + iconClass }></i>
		<span class="text-sm font-semibold">{ fmt.Sprintf("%d", pullRequestCount) }</span>
	</div>
}
