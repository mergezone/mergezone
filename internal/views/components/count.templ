package components

import "fmt"

templ PullRequestStatusCount(iconClass string, pullRequestCount int, statusLabel string, destinationURL string, isActive bool) {
	if destinationURL != "" {
		<div
			class="status-tile grid cursor-pointer grid-cols-[auto_1fr] grid-rows-[auto_auto] items-center justify-items-center gap-x-3 gap-y-2 rounded-lg border border-base-300 bg-base-100 p-3 transition-colors hover:bg-base-200 data-[active=true]:bg-base-200"
			data-active={ fmt.Sprintf("%t", isActive) }
			hx-get={ templ.SafeURL(destinationURL) }
			hx-target="#page-shell"
			hx-push-url="true"
		>
			<p class="col-span-2 text-xs font-semibold text-base-content/70">{ statusLabel }</p>
			<i class={ "status-icon col-start-1 row-start-1 text-2xl " + iconClass }></i>
			<b class="col-start-2 row-start-1 text-2xl leading-none font-bold text-base-content">{ fmt.Sprintf("%d", pullRequestCount) }</b>
		</div>
	} else {
		<div class="status-tile grid grid-cols-[auto_1fr] grid-rows-[auto_auto] items-center justify-items-center gap-x-3 gap-y-2 rounded-lg border border-base-300 bg-base-100 p-3" data-active={ fmt.Sprintf("%t", isActive) }>
			<p class="col-span-2 text-xs font-semibold text-base-content/70">{ statusLabel }</p>
			<i class={ "status-icon col-start-1 row-start-1 text-2xl " + iconClass }></i>
			<b class="col-start-2 row-start-1 text-2xl leading-none font-bold text-base-content">{ fmt.Sprintf("%d", pullRequestCount) }</b>
		</div>
	}
}

templ InlinePullRequestCount(iconClass string, pullRequestCount int) {
	<div class="inline-flex items-center gap-1">
		<i class={ "status-icon " + iconClass }></i>
		<span class="text-sm font-semibold">{ fmt.Sprintf("%d", pullRequestCount) }</span>
	</div>
}
