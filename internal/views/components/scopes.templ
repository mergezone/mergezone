// DEPRECATED: This file will be removed when scope list logic is folded
// into sidebar_card.templ. Prefer adding new sidebar-related code there.
package components

import "merge/internal/model"

templ ScopeSummaries(scopeSummaries []model.ScopeInfo, activeSortOrder string, filters model.RepositoryFilters, currentPage int) {
	<section class="panel scopes filter-section">
		<div
			class="panel-heading section-heading filter-section-heading"
			@click="if (!$event.target.closest('button,a')) $data.collapsed = !$data.collapsed"
			@keydown.enter.prevent="$data.collapsed = !$data.collapsed"
			@keydown.space.prevent="$data.collapsed = !$data.collapsed"
		>
			<span class="section-heading-label">
				<span class="section-heading-control">
					<i class="fa-solid fa-folder-tree section-heading-icon" aria-hidden="true"></i>
					<button
						class="link-button collapse-section-button"
						type="button"
						:aria-expanded="!$data.collapsed"
						:aria-label="$data.collapsed ? 'Expand scopes' : 'Collapse scopes'"
						:title="$data.collapsed ? 'Expand scopes' : 'Collapse scopes'"
						@click.stop="$data.collapsed = !$data.collapsed"
					>
						<i class="fa-solid" :class="$data.collapsed ? 'fa-chevron-down' : 'fa-chevron-up'" aria-hidden="true"></i>
					</button>
				</span>
				<span>Scopes</span>
			</span>
			if len(scopeSummaries) > 0 || len(filters.Scope) > 0 {
				<span class="section-actions">
					<i id="scopes-sort-indicator" class="fa-solid fa-circle-notch fa-spin htmx-indicator" aria-hidden="true"></i>
					<button
						class="link-button sort-control"
						aria-label="Sort scopes by recency"
						title="Sort by recency"
						if activeSortOrder == "recent" {
							data-active-sort="true"
						}
						hx-get={ filters.WithScopeSort("recent").FragmentURL("scopes", currentPage) }
						hx-target="#scopes-section"
						hx-push-url={ filters.WithScopeSort("recent").URL() }
						hx-indicator="#scopes-sort-indicator"
					>
						<i class="fa-solid fa-clock" aria-hidden="true"></i>
					</button>
					<button
						class="link-button sort-control"
						aria-label="Sort scopes by pull request count"
						title="Sort by pull request count"
						if activeSortOrder == "top" {
							data-active-sort="true"
						}
						hx-get={ filters.WithScopeSort("top").FragmentURL("scopes", currentPage) }
						hx-target="#scopes-section"
						hx-push-url={ filters.WithScopeSort("top").URL() }
						hx-indicator="#scopes-sort-indicator"
					>
						<i class="fa-solid fa-arrow-down-wide-short" aria-hidden="true"></i>
					</button>
				</span>
			}
		</div>
		<div class="filter-section-content" x-show="!$data.collapsed">
			if len(scopeSummaries) > 0 {
				for _, scope := range scopeSummaries {
					@ScopeCard(scope, filters)
				}
			}
		</div>
	</section>
}
