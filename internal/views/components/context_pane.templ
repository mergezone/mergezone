package components

templ ContextPane() {
	<aside
		class="context-pane bottom-sheet"
		id="context-pane"
		:class="{ 'open': $store.contextPane.open }"
		@keydown.escape.window="$store.contextPane.closePane()"
	>
		<div class="pane-resize-handle context-pane-resize-handle" role="separator" aria-orientation="vertical" aria-label="Resize pull request details" :aria-valuemin="$store.app.contextPaneMinWidth" :aria-valuemax="$store.app.contextPaneMaxWidth" :aria-valuenow="$store.app.contextPaneWidth" tabindex="0" @pointerdown="$store.app.startPaneResize('context', $event)" @keydown.left.pullRequestevent="$store.app.adjustPaneWidth('context', 16)" @keydown.right.pullRequestevent="$store.app.adjustPaneWidth('context', -16)"></div>
		<div id="context-pane-content">
			<div class="context-pane-header">
				<a class="context-pane-title" :href="$store.contextPane.pullRequestUrl" x-show="$store.contextPane.open">
					<i class="status-icon fa-solid" :class="$store.contextPane.pullRequestStatusClass"></i>
					<span x-html="$store.contextPane.pullRequestTitleHtml"></span>
					<button class="icon-close-button" aria-label="Close" onclick="Alpine.store('contextPane').closePane()">
						<i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
					</button>
				</a>
			</div>
			<div class="context-pane-body scroll" @click="$store.contextPane.openPrRef($event)">
				<section class="panel context-pane-section context-pane-details" x-data="{ collapsed: false }" x-show="$store.contextPane.open">
					<div
						class="panel-heading section-heading context-pane-section-heading"
						role="button"
						tabindex="0"
						:aria-expanded="!$data.collapsed"
						:aria-label="$data.collapsed ? 'Expand details' : 'Collapse details'"
						@click="if (!$event.target.closest('button,a')) $data.collapsed = !$data.collapsed"
						@keydown.enter.prevent="$data.collapsed = !$data.collapsed"
						@keydown.space.prevent="$data.collapsed = !$data.collapsed"
					>
						<span class="section-heading-label">
							<span class="section-heading-control">
								<i class="fa-solid fa-circle-info section-heading-icon" aria-hidden="true"></i>
								<button
									class="link-button collapse-section-button"
									type="button"
									:aria-expanded="!$data.collapsed"
									:aria-label="$data.collapsed ? 'Expand details' : 'Collapse details'"
									:title="$data.collapsed ? 'Expand details' : 'Collapse details'"
									@click.stop="$data.collapsed = !$data.collapsed"
								>
									<i class="fa-solid" :class="$data.collapsed ? 'fa-chevron-down' : 'fa-chevron-up'" aria-hidden="true"></i>
								</button>
							</span>
							<span>Details</span>
						</span>
					</div>
					<div class="panel-block context-pane-section-content" x-show="!$data.collapsed">
						<table class="table is-fullwidth context-pane-meta">
							<tbody>
								<tr class="meta-row">
									<th class="meta-label" scope="row"><i class="fa-solid fa-hashtag" aria-hidden="true"></i> Number</th>
									<td class="meta-value" x-text="'#' + $store.contextPane.pullRequestNumber"></td>
								</tr>
								<tr class="meta-row">
									<th class="meta-label" scope="row"><i class="fa-solid fa-code-pull-request" aria-hidden="true"></i> Status</th>
									<td class="meta-value" x-text="$store.contextPane.pullRequestState"></td>
								</tr>
								<template x-if="$store.contextPane.pullRequestExpiryStatus">
									<tr class="meta-row">
										<th class="meta-label" scope="row"><i class="fa-solid" :class="$store.contextPane.pullRequestExpiryIconClass" aria-hidden="true"></i> State</th>
										<td class="meta-value">
											<span x-text="$store.contextPane.pullRequestExpiryStatus"></span>
											<template x-if="$store.contextPane.pullRequestSupersededBy">
												<span>; <a class="meta-link" :href="$store.contextPane.pullRequestSupersededBy.url" x-text="'#' + $store.contextPane.pullRequestSupersededBy.number"></a> <span x-text="$store.contextPane.pullRequestSupersededBy.reason"></span></span>
											</template>
											<template x-if="$store.contextPane.pullRequestExpiryReason">
												<span>; <span x-text="$store.contextPane.pullRequestExpiryReason"></span></span>
											</template>
										</td>
									</tr>
								</template>
								<tr class="meta-row">
									<th class="meta-label" scope="row"><i class="fa-solid fa-clock" aria-hidden="true"></i> Age</th>
									<td class="meta-value" x-text="$store.contextPane.pullRequestAge"></td>
								</tr>
								<tr class="meta-row">
									<th class="meta-label" scope="row"><i class="fa-regular fa-comments" aria-hidden="true"></i> Discussion</th>
									<td class="meta-value" x-text="$store.contextPane.pullRequestComments"></td>
								</tr>
								<tr class="meta-row">
									<th class="meta-label" scope="row"><i class="fa-solid fa-user" aria-hidden="true"></i> Author</th>
									<td class="meta-value">
										<a class="meta-link" :href="$store.contextPane.pullRequestAuthorUrl" x-text="$store.contextPane.pullRequestAuthorName"></a>
									</td>
								</tr>
								<template x-if="$store.contextPane.pullRequestScope">
									<tr class="meta-row">
										<th class="meta-label" scope="row"><i class="fa-solid fa-tag" aria-hidden="true"></i> Scope</th>
										<td class="meta-value"><a class="meta-link" :href="$store.contextPane.pullRequestScopeURL" x-text="$store.contextPane.pullRequestScope"></a></td>
									</tr>
								</template>
							</tbody>
						</table>
					</div>
				</section>
				<section class="panel context-pane-section context-pane-description" x-data="{ collapsed: false }" x-show="$store.contextPane.open">
					<div
						class="panel-heading section-heading context-pane-section-heading"
						role="button"
						tabindex="0"
						:aria-expanded="!$data.collapsed"
						:aria-label="$data.collapsed ? 'Expand description' : 'Collapse description'"
						@click="if (!$event.target.closest('button,a')) $data.collapsed = !$data.collapsed"
						@keydown.enter.prevent="$data.collapsed = !$data.collapsed"
						@keydown.space.prevent="$data.collapsed = !$data.collapsed"
					>
						<span class="section-heading-label">
							<span class="section-heading-control">
								<i class="fa-solid fa-align-left section-heading-icon" aria-hidden="true"></i>
								<button
									class="link-button collapse-section-button"
									type="button"
									:aria-expanded="!$data.collapsed"
									:aria-label="$data.collapsed ? 'Expand description' : 'Collapse description'"
									:title="$data.collapsed ? 'Expand description' : 'Collapse description'"
									@click.stop="$data.collapsed = !$data.collapsed"
								>
									<i class="fa-solid" :class="$data.collapsed ? 'fa-chevron-down' : 'fa-chevron-up'" aria-hidden="true"></i>
								</button>
							</span>
							<span>Description</span>
						</span>
					</div>
					<div class="panel-block context-pane-section-content" x-show="!$data.collapsed">
						<div class="content context-pane-description-content" x-html="$store.contextPane.bodyHtml"></div>
					</div>
				</section>
				<section class="panel context-pane-section context-pane-discussion" x-data="{ collapsed: true }" x-show="$store.contextPane.open">
					<div
						class="panel-heading section-heading context-pane-section-heading"
						role="button"
						tabindex="0"
						:aria-expanded="!$data.collapsed"
						:aria-label="$data.collapsed ? 'Expand discussion' : 'Collapse discussion'"
						@click="if (!$event.target.closest('button,a')) { $data.collapsed = !$data.collapsed; if (!$data.collapsed) $store.contextPane.loadDiscussion() }"
						@keydown.enter.prevent="$data.collapsed = !$data.collapsed; if (!$data.collapsed) $store.contextPane.loadDiscussion()"
						@keydown.space.prevent="$data.collapsed = !$data.collapsed; if (!$data.collapsed) $store.contextPane.loadDiscussion()"
					>
						<span class="section-heading-label">
							<span class="section-heading-control">
								<i class="fa-solid fa-comments section-heading-icon" aria-hidden="true"></i>
								<button
									class="link-button collapse-section-button"
									type="button"
									:aria-expanded="!$data.collapsed"
									:aria-label="$data.collapsed ? 'Expand discussion' : 'Collapse discussion'"
									:title="$data.collapsed ? 'Expand discussion' : 'Collapse discussion'"
									@click.stop="$data.collapsed = !$data.collapsed; if (!$data.collapsed) $store.contextPane.loadDiscussion()"
								>
									<i class="fa-solid" :class="$data.collapsed ? 'fa-chevron-down' : 'fa-chevron-up'" aria-hidden="true"></i>
								</button>
							</span>
							<span>Discussion</span>
						</span>
					</div>
					<div class="panel-block context-pane-section-content" x-show="!$data.collapsed">
						<div class="discussion-comments" data-loaded="false" data-loading="false"></div>
					</div>
				</section>
				<section class="panel context-pane-section context-pane-changes" x-data="{ collapsed: true }" x-show="$store.contextPane.open">
					<div
						class="panel-heading section-heading context-pane-section-heading"
						role="button"
						tabindex="0"
						:aria-expanded="!$data.collapsed"
						:aria-label="$data.collapsed ? 'Expand changes' : 'Collapse changes'"
						@click="if (!$event.target.closest('button,a')) { $data.collapsed = !$data.collapsed; if (!$data.collapsed) $store.contextPane.loadChanges() }"
						@keydown.enter.prevent="$data.collapsed = !$data.collapsed; if (!$data.collapsed) $store.contextPane.loadChanges()"
						@keydown.space.prevent="$data.collapsed = !$data.collapsed; if (!$data.collapsed) $store.contextPane.loadChanges()"
					>
						<span class="section-heading-label">
							<span class="section-heading-control">
								<i class="fa-solid fa-code-compare section-heading-icon" aria-hidden="true"></i>
								<button
									class="link-button collapse-section-button"
									type="button"
									:aria-expanded="!$data.collapsed"
									:aria-label="$data.collapsed ? 'Expand changes' : 'Collapse changes'"
									:title="$data.collapsed ? 'Expand changes' : 'Collapse changes'"
									@click.stop="$data.collapsed = !$data.collapsed; if (!$data.collapsed) $store.contextPane.loadChanges()"
								>
									<i class="fa-solid" :class="$data.collapsed ? 'fa-chevron-down' : 'fa-chevron-up'" aria-hidden="true"></i>
								</button>
							</span>
							<span>Changes</span>
						</span>
					</div>
					<div class="panel-block context-pane-section-content" x-show="!$data.collapsed">
						<div class="context-pane-diffs" x-ref="changes"></div>
					</div>
				</section>
			</div>
		</div>
	</aside>
}
