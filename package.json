{
  "name": "mergezone",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.3",
  "description": "Pull request analytics for public GitHub repositories.",
  "scripts": {
    "build:css": "sass --no-source-map --style=compressed --quiet-deps --load-path=node_modules public/main.scss public/main.css",
    "watch:css": "sass --watch --no-source-map --style=compressed --quiet-deps --load-path=node_modules public/main.scss public/main.css",
    "format": "prettier --write \"**/*.{scss,css,js,html,json}\""
  },
  "devDependencies": {
    "bulma": "1.0.4",
    "prettier": "^3.9.10",
    "sass": "1.105.1"
  }
}
