{
  "name": "mergezone",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.3",
  "description": "Pull request analytics for public GitHub repositories.",
  "scripts": {
    "build:css": "tailwindcss -i internal/views/styles/app.css -o public/main.css --minify",
    "watch:css": "tailwindcss -i internal/views/styles/app.css -o public/main.css --watch",
    "format": "prettier --write \"**/*.{css,js,html,json}\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "daisyui": "^5.7.50",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3"
  }
}
